---
import { Menu, X } from 'lucide-astro';
import siteConfig from '../../site.config';

// One list, read twice. The desktop and mobile navigations were two hand-kept
// copies of the same five labels, so a rename meant two edits and the footer
// silently disagreed with both.
const navItems = siteConfig.nav;

const desktopLinkClass = 'text-ink-muted hover:text-brand-ink transition-colors font-medium';
const desktopCtaClass = 'btn-primary text-sm';
const mobileLinkClass = 'block text-ink-muted hover:text-brand-ink transition-colors font-medium';
const mobileCtaClass = 'inline-block btn-primary text-sm w-full text-center';
---

<header class="bg-surface-raised shadow-xs sticky top-0 z-50" role="banner">
  <nav
    class="container flex items-center justify-between h-16"
    aria-label={siteConfig.header.primaryNavLabel}
  >
    <!-- Logo -->
    <a
      href="/"
      class="flex items-center space-x-2 text-xl font-bold text-brand-ink hover:text-brand-hover transition-colors"
      aria-label={`${siteConfig.groupName} ${siteConfig.header.homeLabel}`}
    >
      <span class="text-2xl">{siteConfig.header.logoEmoji}</span>
      <span>{siteConfig.groupName}</span>
    </a>

    <!-- Desktop Navigation -->
    <ul class="hidden md:flex items-center space-x-6">
      {
        navItems.map((item) => (
          <li>
            <a href={item.href} class={item.cta ? desktopCtaClass : desktopLinkClass}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Mobile Menu Toggle -->
    <button
      type="button"
      class="md:hidden p-2 rounded-lg hover:bg-surface-sunken transition-colors focus:outline-hidden focus:ring-2 focus:ring-focus"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label={siteConfig.header.menuToggleLabel}
      id="mobile-menu-toggle"
      data-mobile-toggle
    >
      <Menu class="w-6 h-6 text-ink-muted" data-icon-open />
      <X class="w-6 h-6 text-ink-muted hidden" data-icon-close />
    </button>
  </nav>

  <!-- Mobile Navigation -->
  <nav
    id="mobile-menu"
    class="md:hidden hidden bg-surface-raised border-t border-border"
    aria-label={siteConfig.header.mobileNavLabel}
    data-mobile-menu
  >
    <ul class="container py-4 space-y-3">
      {
        navItems.map((item) => (
          <li>
            <a href={item.href} class={item.cta ? mobileCtaClass : mobileLinkClass}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
    const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
    const iconOpen = document.querySelector('[data-icon-open]');
    const iconClose = document.querySelector('[data-icon-close]');

    if (!(toggle && menu && iconOpen && iconClose)) return;

    const isOpen = () => !menu.classList.contains('hidden');

    const openMenu = () => {
      menu.classList.remove('hidden');
      toggle.setAttribute('aria-expanded', 'true');
      iconOpen.classList.add('hidden');
      iconClose.classList.remove('hidden');
    };

    // Single close path for every trigger (toggle click, link click, Escape,
    // focus leaving) so aria-expanded, the hidden class and the two icon
    // states can never drift out of sync between call sites.
    const closeMenu = ({ returnFocus = false } = {}) => {
      if (!isOpen()) return;
      menu.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
      iconOpen.classList.remove('hidden');
      iconClose.classList.add('hidden');
      if (returnFocus) {
        toggle.focus();
      }
    };

    toggle.addEventListener('click', () => {
      if (isOpen()) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Close mobile menu when clicking a link. The browser is navigating away,
    // so focus is not redirected.
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });

    // Escape closes the menu from anywhere inside it, or from the toggle,
    // and returns focus to the toggle.
    const handleEscape = (event: KeyboardEvent) => {
      if (event.key !== 'Escape' || !isOpen()) return;
      closeMenu({ returnFocus: true });
    };
    toggle.addEventListener('keydown', handleEscape);
    menu.addEventListener('keydown', handleEscape);

    // Tabbing (or clicking) focus away from the toggle and the menu closes
    // it, so it is never left open with focus somewhere unrelated. This is a
    // disclosure close, not a focus trap: focus is free to land anywhere.
    menu.addEventListener('focusout', (event: FocusEvent) => {
      const next = event.relatedTarget as Node | null;
      if (next && (menu.contains(next) || next === toggle)) return;
      closeMenu();
    });
  });
</script>
