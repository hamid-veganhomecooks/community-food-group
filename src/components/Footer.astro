---
import { getEntry, render } from 'astro:content';
import siteConfig from '../../site.config';

// A fragment, not a route: nothing looks it up by id and nothing enumerates
// the collection, so it renders here and nowhere else.
const footerBlurb = await getEntry('pages', 'footer');

if (!footerBlurb) {
  throw new Error("Content entry 'pages/footer' was not found");
}

const { Content } = await render(footerBlurb);

// One navigation list, shared with the header. The footer has never carried a
// home link - the header wordmark already is one - so it drops that entry
// rather than keeping a second, disagreeing list.
const quickLinks = siteConfig.nav.filter((item) => item.href !== '/');
---

<footer class="bg-surface-inverse text-ink-inverse-muted py-12" role="contentinfo">
  <div class="container">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- About Section -->
      <div>
        <h3 class="text-ink-inverse font-semibold text-lg mb-4">{siteConfig.groupName}</h3>
        <div class="text-sm">
          <Content />
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-ink-inverse font-semibold text-lg mb-4">
          {siteConfig.footer.quickLinksHeading}
        </h4>
        <ul class="space-y-2 text-sm">
          {
            quickLinks.map((item) => (
              <li>
                <a href={item.href} class="hover:text-ink-inverse transition-colors">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Connect -->
      <div>
        <h4 class="text-ink-inverse font-semibold text-lg mb-4">
          {siteConfig.footer.connectHeading}
        </h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a
              href={`mailto:${siteConfig.contactEmail}`}
              class="hover:text-ink-inverse transition-colors"
            >
              <span aria-hidden="true">{siteConfig.footer.emailEmoji}</span>{' '}{
                siteConfig.footer.emailLabel
              }
            </a>
          </li>
          <li>
            <a href={siteConfig.footer.joinHref} class="hover:text-ink-inverse transition-colors">
              <span aria-hidden="true">{siteConfig.footer.joinEmoji}</span>{' '}{
                siteConfig.footer.joinLabel
              }
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-ink-inverse-muted/30 mt-8 pt-6 text-sm text-center md:text-left">
      <p>
        &copy; {new Date().getFullYear()} {siteConfig.groupName}. {siteConfig.footer.rightsNotice}
      </p>
      <p class="mt-1 text-xs">
        {siteConfig.footer.colophon}
      </p>
    </div>
  </div>
</footer>
