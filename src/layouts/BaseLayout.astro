---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import siteConfig from '../../site.config';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  pageTitle?: string;
}

const { title, description, ogImage, pageTitle } = Astro.props;
const siteTitle = siteConfig.groupName;
const fullTitle = pageTitle ? `${pageTitle} | ${siteTitle}` : title || siteTitle;
const metaDescription = description || siteConfig.tagline || siteConfig.groupName;
const metaImage = ogImage || '/images/og-default.jpg';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={metaImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={metaImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-inter" preload />
  </head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-4 focus:bg-surface focus:text-brand-ink focus:font-bold">
      Skip to main content
    </a>

    <Header />

    <main id="main-content" role="main">
      <slot />
    </main>

    <Footer />
  </body>
</html>