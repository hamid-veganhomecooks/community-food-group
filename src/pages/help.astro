---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const helpPage = await getEntry('pages', 'help');

if (!helpPage) {
  throw new Error("Content entry 'pages/help' was not found");
}

const { Content } = await render(helpPage);
---

<BaseLayout
  title={helpPage.data.title}
  description={helpPage.data.description}
  pageTitle={helpPage.data.heroTitle || helpPage.data.title}
>
  <div class="section bg-surface">
    <div class="container">
      <article class="prose-card">
        <div class="prose prose-lg">
          <Content />
        </div>
      </article>
    </div>
  </div>
</BaseLayout>
