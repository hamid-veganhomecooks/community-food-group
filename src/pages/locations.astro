---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { MapPin, CalendarDays } from 'lucide-astro';
import siteConfig from '../../site.config';

const locationsPage = await getEntry('pages', 'locations');

if (!locationsPage) {
  throw new Error("Content entry 'pages/locations' was not found");
}

const { Content } = await render(locationsPage);

const locations = await getCollection('locations');
---

<BaseLayout
  title={locationsPage.data.title}
  description={locationsPage.data.description}
  pageTitle={locationsPage.data.heroTitle || locationsPage.data.title}
>
  <div class="section bg-surface">
    <div class="container">
      {/*
        The centred treatment this route has always used, kept deliberately:
        the copy introduces the cards below it rather than standing on its own,
        so it does not take the `prose-card` the three long-form MDX routes
        use. The classes live here rather than in the content file because
        markdown emits bare elements.
      */}
      <div
        class="max-w-3xl mx-auto text-center [&>h1]:text-title [&>h2]:text-heading [&>h2]:mt-stack [&>p]:text-lead [&>p]:text-ink-muted [&>p]:max-w-lede [&>p]:mx-auto [&>p]:mt-stack-sm [&_a]:font-medium"
      >
        <Content />
      </div>

      <div class="grid grid-cols-1 gap-stack mt-stack max-w-3xl mx-auto">
        {locations.map((location) => (
          <article id={location.id} class="card">
            <h3 class="text-subheading font-bold text-brand-ink mb-stack-sm">
              {location.data.name}
            </h3>

            <div class="space-y-4 text-ink">
              {/*
                The address is published; a directions link deliberately is not. Access
                needs a plot fee and a membership with the garden's operator, so routing
                a neighbor there would be a promise the site cannot keep.
              */}
              <div class="flex items-start space-x-2">
                <MapPin class="w-5 h-5 text-brand-ink shrink-0 mt-0.5" aria-hidden="true" />
                <p>{location.data.address}</p>
              </div>

              <div class="flex items-start space-x-2">
                <CalendarDays class="w-5 h-5 text-brand-ink shrink-0 mt-0.5" aria-hidden="true" />
                <p>{location.data.cadence}</p>
              </div>
            </div>

            <p class="mt-stack-sm text-ink">
              {location.data.description}
            </p>

            <p class="mt-stack-sm text-label text-ink-muted">
              {siteConfig.locations.operatedByLabel}{' '}
              <a
                href={location.data.operatorUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-brand-ink hover:text-brand-hover font-medium"
                >{location.data.operatorName}</a
              >
            </p>
          </article>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
