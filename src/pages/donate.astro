---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const donatePage = await getEntry('pages', 'donate');

if (!donatePage) {
  throw new Error("Content entry 'pages/donate' was not found");
}

const { Content } = await render(donatePage);
---

<BaseLayout
  title={donatePage.data.title}
  description={donatePage.data.description}
  pageTitle={donatePage.data.heroTitle || donatePage.data.title}
>
  <div class="section bg-cream">
    <div class="container">
      <article class="prose prose-lg max-w-4xl mx-auto bg-white rounded-lg shadow-md p-8 md:p-12">
        <Content />
      </article>
    </div>
  </div>
</BaseLayout>