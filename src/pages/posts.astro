---
import BaseLayout from '../layouts/BaseLayout.astro';
import MastodonFeed from '../components/MastodonFeed.astro';
---

<BaseLayout
  title="Updates"
  description="Latest updates from our community"
  pageTitle="All Updates"
>
  <div class="section bg-surface">
    <div class="container">
      <div class="max-w-3xl mx-auto text-center mb-stack">
        <h1 class="text-title font-bold text-brand-ink">
          Community Updates
        </h1>
        <p class="text-lead text-ink-muted max-w-lede mx-auto mt-stack-sm">
          Short updates from the group, posted as things happen.
        </p>
      </div>

      <MastodonFeed limit={20} />
    </div>
  </div>
</BaseLayout>