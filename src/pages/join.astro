---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const joinPage = await getEntry('pages', 'join');

if (!joinPage) {
  throw new Error("Content entry 'pages/join' was not found");
}

const { Content } = await render(joinPage);
---

<BaseLayout
  title={joinPage.data.title}
  description={joinPage.data.description}
  pageTitle={joinPage.data.heroTitle || joinPage.data.title}
>
  <div class="section bg-cream">
    <div class="container">
      <article class="prose prose-lg max-w-4xl mx-auto bg-white rounded-lg shadow-md p-8 md:p-12">
        <Content />
      </article>
    </div>
  </div>
</BaseLayout>