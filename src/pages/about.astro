---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const aboutPage = await getEntry('pages', 'about');

if (!aboutPage) {
  throw new Error("Content entry 'pages/about' was not found");
}

const { Content } = await render(aboutPage);
---

<BaseLayout
  title={aboutPage.data.title}
  description={aboutPage.data.description}
  pageTitle={aboutPage.data.heroTitle || aboutPage.data.title}
>
  <div class="section bg-cream">
    <div class="container">
      <article class="prose-card">
        <div class="prose prose-lg">
          <Content />
        </div>
      </article>
    </div>
  </div>
</BaseLayout>