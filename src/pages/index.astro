---
import BaseLayout from '../layouts/BaseLayout.astro';
import MastodonFeed from '../components/MastodonFeed.astro';
import locations from '../data/locations.json';
---

<BaseLayout
  title="Home"
  description="Community Food Group - Building food security through community action"
  pageTitle="Welcome"
>
  <!-- Hero Section -->
  <section class="section-lg bg-linear-to-r from-terracotta to-terracotta-dark text-white">
    <div class="container">
      <div class="max-w-3xl">
        <h1 class="text-display font-bold text-white">
          Nourishing Our Community
        </h1>
        <p class="text-lead text-cream/90 max-w-lede mt-stack">
          Building a more food-secure future through connection, education, and community action.
        </p>
        <div class="flex flex-wrap gap-4 mt-stack">
          <a href="/join" class="btn-secondary bg-white text-terracotta hover:bg-cream">
            Join us
          </a>
          <a href="/donate" class="btn-primary bg-cream text-terracotta-dark hover:bg-white">
            Donate
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Updates Section -->
  <section class="section bg-cream">
    <div class="container">
      <h2 class="text-heading font-bold text-terracotta-dark">
        Latest Updates
      </h2>
      <div class="mt-stack">
        <MastodonFeed limit={6} />
      </div>
      <div class="mt-stack text-center">
        <a href="/posts" class="btn-primary">
          View all updates
        </a>
      </div>
    </div>
  </section>

  <!-- Locations Preview -->
  <section class="section bg-white">
    <div class="container">
      <h2 class="text-heading font-bold text-terracotta-dark">
        Our Locations
      </h2>
      <p class="text-lead text-gray-600 max-w-lede mt-stack-sm">
        Visit us at any of our community locations. We're here to serve you.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-stack mt-stack">
        {locations.slice(0, 3).map((location) => (
          <div class="card">
            <h3 class="text-subheading font-semibold text-terracotta">
              {location.name}
            </h3>
            <p class="text-label text-gray-600 mt-2">{location.address}</p>
            <p class="text-gray-700 mt-stack-sm">{location.description}</p>
            <a
              href={`/locations#${location.id}`}
              class="text-label text-terracotta hover:text-terracotta-dark font-medium inline-flex items-center mt-stack-sm"
            >
              Learn more →
            </a>
          </div>
        ))}
      </div>
      <div class="mt-stack text-center">
        <a href="/locations" class="btn-primary">
          View all locations
        </a>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="section-tight bg-sage text-white">
    <div class="container text-center">
      <h2 class="text-heading font-bold text-white">
        Ready to Make a Difference?
      </h2>
      <p class="text-lead text-cream/90 max-w-lede mx-auto mt-stack-sm">
        Whether you have an hour or a day, your contribution helps build a stronger community.
      </p>
      <div class="flex flex-wrap justify-center gap-4 mt-stack">
        <a href="/join" class="btn-primary bg-white text-sage-dark hover:bg-cream">
          Volunteer today
        </a>
        <a href="/donate" class="btn-secondary bg-cream text-sage-dark hover:bg-white">
          Support our mission
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
