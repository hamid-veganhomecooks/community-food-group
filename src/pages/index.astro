---
import BaseLayout from '../layouts/BaseLayout.astro';
import MastodonFeed from '../components/MastodonFeed.astro';
import siteConfig from '../../site.config';
---

<BaseLayout
  title="Home"
  pageTitle="Welcome"
>
  <!-- Hero Section -->
  <section class="section-lg bg-linear-to-r from-brand to-brand-hover text-ink-inverse">
    <div class="container">
      <div class="max-w-3xl">
        <h1 class="text-display font-bold text-ink-inverse">
          Vegan Mutual Aid 💪
        </h1>
        <p class="text-lead text-ink-inverse max-w-lede mt-stack">
          A mutual aid group in Tucson, Arizona. Everything we cook is vegan, and it goes
          straight to people around town.
        </p>
        <div class="flex flex-wrap gap-4 mt-stack">
          <a href="/join" class="btn-secondary bg-surface-raised text-brand-ink hover:bg-surface">
            Cook with us
          </a>
          <a href="/help" class="btn-primary bg-surface text-brand-ink hover:bg-surface-raised">
            Ways to help
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Updates Section -->
  <section class="section bg-surface">
    <div class="container">
      <h2 class="text-heading font-bold text-brand-ink">
        Latest Updates
      </h2>
      <div class="mt-stack">
        <MastodonFeed limit={6} />
      </div>
      <div class="mt-stack text-center">
        <a href="/posts" class="btn-primary">
          View all updates
        </a>
      </div>
    </div>
  </section>

  <!--
    How It Works. This replaces the old three-up locations grid: the group names no cook
    or distribution site publicly, so there is one record and nothing to lay out in a
    three-column grid. Copy plus a link to /locations, not a card list.
  -->
  <section class="section bg-surface-raised">
    <div class="container">
      <div class="max-w-lede">
        <h2 class="text-heading font-bold text-brand-ink">
          How It Works
        </h2>
        <p class="text-lead text-ink-muted mt-stack-sm">
          Once a month we get together, cook, and then take the food out and hand it to
          people directly - including at street locations like bus stops.
        </p>
        <p class="text-ink mt-stack-sm">
          We do not publish a time or a place in advance. The arrangements are made close to
          the date and they genuinely change, so anything printed here would be wrong more
          often than it was right. Write to{' '}
          <a href={`mailto:${siteConfig.contactEmail}`} class="text-brand-ink hover:text-brand-hover font-medium"
            >{siteConfig.contactEmail}</a
          >{' '}and a person will write back with the details.
        </p>
        <p class="text-ink mt-stack-sm">
          There is one place we can name: a plot we rent at a community garden, which grows
          some of what we cook.
        </p>
      </div>
      <div class="mt-stack">
        <a href="/locations" class="btn-primary">
          Where we are
        </a>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="section-tight bg-accent text-ink-inverse">
    <div class="container text-center">
      <h2 class="text-heading font-bold text-ink-inverse">
        Come and Cook
      </h2>
      <p class="text-lead text-ink-inverse max-w-lede mx-auto mt-stack-sm">
        There is no form and no sign-up. Ingredients, containers, kitchen time and a vehicle
        help just as much as an afternoon of cooking.
      </p>
      <div class="flex flex-wrap justify-center gap-4 mt-stack">
        <a href="/join" class="btn-primary bg-surface-raised text-accent-ink hover:bg-surface">
          Get involved
        </a>
        <a href="/help" class="btn-secondary bg-surface text-accent-ink hover:bg-surface-raised">
          Ways to help
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
