---
import BaseLayout from '../layouts/BaseLayout.astro';
import MastodonFeed from '../components/MastodonFeed.astro';
import Actions from '../components/home/Actions.astro';
import Band from '../components/home/Band.astro';
import Hero from '../components/home/Hero.astro';
import { getEntry, render } from 'astro:content';

const homePage = await getEntry('pages', 'home');

if (!homePage) {
  throw new Error("Content entry 'pages/home' was not found");
}

const { Content } = await render(homePage);
---

<BaseLayout
  title={homePage.data.title}
  description={homePage.data.description}
  pageTitle={homePage.data.heroTitle || homePage.data.title}
>
  {/*
    Components are handed to the document from here rather than imported at the
    top of home.mdx, so the file the owner edits holds copy and nothing else.
  */}
  <Content components={{ Hero, Band, Actions, MastodonFeed }} />
</BaseLayout>
