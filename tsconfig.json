{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@data/*": ["src/data/*"],
      "@content/*": ["src/content/*"]
    },
    "strictNullChecks": true,
    "allowJs": true,
    "resolveJsonModule": true
  }
}