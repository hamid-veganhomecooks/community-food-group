# Copy to .env for local development:  cp .env.example .env
#
# Every value here is optional. With none of them set, the site still builds and
# the Mastodon feed is simply skipped.

# The group's Mastodon account, in user@instance form. A leading @ is accepted.
# Leave blank to disable the feed entirely.
# Example shape only, not a real account:  ourgroup@example.social
MASTODON_ACCOUNT=

# How many recent posts to cache. Whole number from 1 to 40. Defaults to 20.
MASTODON_POST_LIMIT=20

# NOTE: SITE_URL is deliberately not listed here.
# astro.config.mjs is evaluated before Astro loads .env, so a SITE_URL set in
# this file would be silently ignored. Pass it on the command line
# (SITE_URL=https://example.org npm run build) or set it as a deployment
# environment variable.
